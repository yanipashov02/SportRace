@page
@model SportRace.Web.Pages.Admin.Disciplines.CreateModel

@{
    ViewData["Title"] = "Нова дисциплина";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="display-6 fw-bold">Нова дисциплина</h1>
        <p class="text-muted">
            Добавяне на нова спортна дисциплина в SportRace.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Discipline.Name"
                           class="form-label">
                        Име на дисциплината
                    </label>

                    <input asp-for="Discipline.Name"
                           class="form-control" />

                    <span asp-validation-for="Discipline.Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Discipline.Description"
                           class="form-label">
                        Описание
                    </label>

                    <textarea asp-for="Discipline.Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Discipline.Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Discipline.IsActive"
                           class="form-check-input" />

                    <label asp-for="Discipline.IsActive"
                           class="form-check-label">
                        Активна дисциплина
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Създай дисциплина
                    </button>

                    <a href="/Admin/Disciplines"
                       class="btn btn-secondary">
                        Отказ
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}