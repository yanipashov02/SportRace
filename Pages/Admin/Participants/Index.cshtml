@page
@model SportRace.Web.Pages.Admin.Participants.IndexModel

@{
    ViewData["Title"] = "Участници";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">Управление на участници</h1>
            <p class="text-muted">
                Преглед и управление на регистрираните участници в SportRace.
            </p>
        </div>

        <a href="/Admin/Participants/Create"
           class="btn btn-primary">
            Нов участник
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Participants.Count == 0)
    {
        <div class="alert alert-info">
            Няма добавени участници.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>№</th>
                        <th>Име</th>
                        <th>Фамилия</th>
                        <th>E-mail</th>
                        <th>Телефон</th>
                        <th>Дата на раждане</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var participant in Model.Participants)
                    {
                        <tr>
                            <td>@participant.Id</td>

                            <td>@participant.FirstName</td>

                            <td>@participant.LastName</td>

                            <td>@participant.Email</td>

                            <td>@participant.PhoneNumber</td>

                            <td>
                                @participant.DateOfBirth.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a href="/Admin/Participants/Edit?id=@participant.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Редактиране
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@participant.Id"
                                          onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този участник?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Изтриване
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>