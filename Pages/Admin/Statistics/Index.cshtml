@page
@model SportRace.Web.Pages.Admin.Statistics.IndexModel
@{
    ViewData["Title"] = "Статистика и справки";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Статистика и справки</h1>
        <p class="text-muted mb-0">Обобщена информация за състезанията, регистрациите и резултатите.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Състезания</div><div class="stat-value">@Model.Statistics.EventsCount</div></div></div></div>
            <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Участници</div><div class="stat-value">@Model.Statistics.ParticipantsCount</div></div></div></div>
            <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Регистрации</div><div class="stat-value">@Model.Statistics.RegistrationsCount</div></div></div></div>
            <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Резултати</div><div class="stat-value">@Model.Statistics.ResultsCount</div></div></div></div>
            <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Завършили</div><div class="stat-value">@Model.Statistics.FinishedCount</div></div></div></div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-8">
                        <label for="eventId" class="form-label fw-semibold">Справка по състезание</label>
                        <select id="eventId" name="eventId" class="form-select">
                            <option value="">Всички състезания</option>
                            @foreach (var sportEvent in Model.Events.OrderByDescending(x => x.EventDate))
                            {
                                if (Model.EventId == sportEvent.Id)
                                {
                                    <option value="@sportEvent.Id" selected>@sportEvent.Name</option>
                                }
                                else
                                {
                                    <option value="@sportEvent.Id">@sportEvent.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Покажи справка</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Изчисти</a>
                    </div>
                </form>
            </div>
        </div>

        @if (Model.Statistics.EventReports.Count == 0)
        {
            <div class="alert alert-info">Няма данни за избраното състезание.</div>
        }
        else
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Справка по състезания</h2></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Състезание</th><th>Дата</th><th>Място</th><th>Регистрации</th><th>Резултати</th><th>Завършили</th><th>Най-добро време</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var report in Model.Statistics.EventReports)
                        {
                            <tr>
                                <td class="fw-semibold">@report.Name</td>
                                <td>@report.EventDate.ToString("dd.MM.yyyy")</td>
                                <td>@report.Location</td>
                                <td>@report.RegistrationsCount</td>
                                <td>@report.ResultsCount</td>
                                <td>@report.FinishedCount</td>
                                <td>@(report.BestFinalTime?.ToString(@"hh\:mm\:ss") ?? "-")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
