@page
@model SportRace.Web.Pages.Admin.EventsModel

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">Управление на състезания</h1>
            <p class="text-muted">
                Създаване, преглед, редактиране и изтриване на спортни събития.
            </p>
        </div>

        <a href="/Admin/CreateEvent" class="btn btn-primary">
            Ново състезание
        </a>
    </div>

    @if (Model.Events.Count == 0)
    {
        <div class="alert alert-info">
            Няма налични състезания.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Име</th>
                        <th>Място</th>
                        <th>Дата</th>
                        <th>Краен срок</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var sportEvent in Model.Events)
                    {
                        <tr>
                            <td>
                                <strong>@sportEvent.Name</strong>
                            </td>

                            <td>
                                @sportEvent.Location
                            </td>

                            <td>
                                @sportEvent.EventDate.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @sportEvent.RegistrationDeadline.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @if (sportEvent.IsPublished)
                                {
                                    <span class="badge bg-success">
                                        Публикувано
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Непубликувано
                                    </span>
                                }
                            </td>

                            <td>
                                <a href="/Events/Details?id=@sportEvent.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Преглед
                                </a>

                                <a href="/Admin/EditEvent?id=@sportEvent.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    Редактиране
                                </a>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@sportEvent.Id" style="display:inline;">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Изтриване
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>