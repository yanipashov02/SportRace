@page
@model SportRace.Web.Pages.Admin.StartLists.IndexModel
@{ViewData["Title"]="Стартови списъци";}
<div class="container py-5"><h1 class="fw-bold">Стартови списъци</h1><p class="text-muted">Генериране и публикуване на стартови номера за регистрираните участници.</p>@if(Model.Message!=null){<div class="alert alert-info">@Model.Message</div>}<form method="post" asp-page-handler="Generate" class="card card-body shadow-sm mb-4"><div class="row g-2"><div class="col"><select name="eventId" class="form-select" required><option value="">-- Изберете състезание --</option>@foreach(var e in Model.Events){<option value="@e.Id">@e.Name</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Генерирай стартов списък</button></div></div></form>
@if(Model.StartLists.Count==0){<div class="alert alert-info">Няма стартови списъци.</div>}else{<table class="table table-hover"><thead><tr><th>ID</th><th>Състезание</th><th>Създаден</th><th>Участници</th><th>Статус</th><th></th></tr></thead><tbody>@foreach(var s in Model.StartLists){<tr><td>@s.Id</td><td>@s.EventName</td><td>@s.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>@s.EntryCount</td><td>@(s.IsPublished?"Публикуван":"Чернова")</td><td><a asp-page="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Преглед</a> @if(!s.IsPublished){<form method="post" asp-page-handler="Publish" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-success">Публикувай</button></form>} <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-danger">Изтрий</button></form></td></tr>}</tbody></table>}</div>
