@page
@model SportRace.Web.Pages.Admin.Results.CreateModel
@{ViewData["Title"]="Нов резултат";}
<div class="container py-5"><h1>Нов резултат</h1><form method="post" class="card card-body shadow-sm mt-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">Регистрация</label><select asp-for="Result.RegistrationId" class="form-select" required><option value="">-- Изберете участник --</option>@foreach(var r in Model.Registrations){<option value="@r.Id">@r.ParticipantName — @r.EventName — @r.DisciplineName</option>}</select></div><div class="mb-3"><label class="form-label">Време (чч:мм:сс)</label><input asp-for="Result.TotalTime" class="form-control" step="1"/></div><div class="mb-3"><label class="form-label">Наказателни секунди</label><input asp-for="Result.PenaltySeconds" type="number" min="0" class="form-control"/></div><div class="form-check mb-3"><input asp-for="Result.IsFinished" class="form-check-input"/><label class="form-check-label">Финиширал</label></div><div><button class="btn btn-primary">Запиши резултат</button> <a asp-page="Index" class="btn btn-secondary">Отказ</a></div></form></div>
