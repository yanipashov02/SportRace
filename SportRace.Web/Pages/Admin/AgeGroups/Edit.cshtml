@page "{id:int}"
@model SportRace.Web.Pages.Admin.AgeGroups.EditModel
@{ViewData["Title"]="Редактиране на възрастова група";}
<div class="container py-5"><h1>Редактиране на възрастова група</h1><form method="post" class="card card-body shadow-sm mt-4"><input type="hidden" asp-for="AgeGroup.Id"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label class="form-label">Име</label><input asp-for="AgeGroup.Name" class="form-control" required/></div><div class="row"><div class="col"><label class="form-label">Минимална възраст</label><input asp-for="AgeGroup.MinAge" class="form-control"/></div><div class="col"><label class="form-label">Максимална възраст</label><input asp-for="AgeGroup.MaxAge" class="form-control"/></div></div><div class="form-check my-3"><input asp-for="AgeGroup.IsActive" class="form-check-input"/><label class="form-check-label">Активна</label></div><div><button class="btn btn-primary">Запази</button> <a asp-page="Index" class="btn btn-secondary">Отказ</a></div></form></div>
