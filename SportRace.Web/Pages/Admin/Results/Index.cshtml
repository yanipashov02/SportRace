@page
@model SportRace.Web.Pages.Admin.Results.IndexModel
@{ViewData["Title"]="Резултати и класиране";}
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="fw-bold">Резултати и класиране</h1><p class="text-muted mb-0">Въвеждане на времена, наказания и автоматично класиране.</p></div><a asp-page="Create" class="btn btn-primary">Нов резултат</a></div>@if(Model.Message!=null){<div class="alert alert-info">@Model.Message</div>}
@if(Model.Results.Count==0){<div class="alert alert-info">Няма въведени резултати.</div>}else{<div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-dark"><tr><th>Поз.</th><th>Участник</th><th>Събитие</th><th>Дисциплина</th><th>Категория</th><th>Време</th><th>Наказание</th><th>Крайно време</th><th></th></tr></thead><tbody>@foreach(var r in Model.Results){<tr><td>@(r.Position==0?"-":r.Position)</td><td>@r.ParticipantName</td><td>@r.EventName</td><td>@r.DisciplineName</td><td>@r.CategoryName / @r.AgeGroupName</td><td>@r.TotalTime</td><td>@r.PenaltySeconds сек.</td><td><strong>@r.FinalTime</strong></td><td><a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Редактирай</a> <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline"><button class="btn btn-sm btn-danger">Изтрий</button></form></td></tr>}</tbody></table></div>}</div>
