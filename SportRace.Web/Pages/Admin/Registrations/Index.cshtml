@page
@model SportRace.Web.Pages.Admin.Registrations.IndexModel

@{
    ViewData["Title"] = "Управление на регистрации";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Управление на регистрации</h1>
            <p class="text-muted mb-0">
                Преглед и управление на регистрациите за спортни събития в SportRace.
            </p>
        </div>
        <a asp-page="Create" class="btn btn-primary">Нова регистрация</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Registrations == null || Model.Registrations.Count == 0)
    {
        <div class="alert alert-info">
            Няма добавени регистрации.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>№</th>
                        <th>Участник</th>
                        <th>Събитие</th>
                        <th>Дисциплина</th>
                        <th>Категория</th>
                        <th>Възрастова група</th>
                        <th>Дата на регистрация</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registration in Model.Registrations)
                    {
                        <tr>
                            <td>@registration.Id</td>

                            <td>
                                @registration.ParticipantName
                            </td>

                            <td>
                                @registration.EventName
                            </td>

                            <td>
                                @registration.DisciplineName
                            </td>

                            <td>
                                @registration.CategoryName
                            </td>

                            <td>
                                @registration.AgeGroupName
                            </td>

                            <td>
                                @registration.RegisteredAt.ToString("dd.MM.yyyy HH:mm")
                            </td>

                            <td>
                                @if (registration.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Одобрена
                                    </span>
                                }
                                else if (registration.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Отказана
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Изчаква
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-page="Edit" asp-route-id="@registration.Id" class="btn btn-sm btn-outline-warning me-1">Статус</a>
                                <form method="post"
                                      class="d-inline"
                                      asp-page-handler="Delete"
                                      asp-route-id="@registration.Id"
                                      onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази регистрация?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Изтриване
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>