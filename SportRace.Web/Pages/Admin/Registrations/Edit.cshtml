@page "{id:int}"
@model SportRace.Web.Pages.Admin.Registrations.EditModel
@{ViewData["Title"]="Статус на регистрация";}
<div class="container py-5"><h1>Статус на регистрация</h1><form method="post" class="card card-body shadow-sm mt-4"><input type="hidden" asp-for="Registration.Id"/><input type="hidden" asp-for="Registration.ParticipantId"/><input type="hidden" asp-for="Registration.EventId"/><input type="hidden" asp-for="Registration.DisciplineId"/><input type="hidden" asp-for="Registration.CategoryId"/><input type="hidden" asp-for="Registration.AgeGroupId"/><div class="mb-3"><label class="form-label">Статус</label><select asp-for="Registration.Status" class="form-select"><option value="Pending">Изчаква</option><option value="Approved">Одобрена</option><option value="Rejected">Отказана</option></select></div><button class="btn btn-primary">Запази</button> <a asp-page="Index" class="btn btn-secondary">Отказ</a></form></div>
