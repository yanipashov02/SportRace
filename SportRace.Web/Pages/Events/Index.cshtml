@page
@model IndexModel

@{
    ViewData["Title"] = "Състезания";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Предстоящи състезания</h1>
        <p class="lead">
            Разгледайте предстоящите спортни събития в SportRace.
        </p>
    </div>

    @if (Model.Events.Count == 0)
    {
        <div class="alert alert-info text-center">
            В момента няма налични състезания.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var sportEvent in Model.Events)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h3 class="card-title">
                                @sportEvent.Name
                            </h3>

                            <p class="card-text">
                                @sportEvent.Description
                            </p>

                            <p class="mb-2">
                                <strong>Място:</strong>
                                @sportEvent.Location
                            </p>

                            <p class="mb-0">
                                <strong>Дата:</strong>
                                @sportEvent.EventDate.ToString("dd.MM.yyyy HH:mm")
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0">
                            <a href="/Events/Details?id=@sportEvent.Id" class="btn btn-primary w-100">
                                Виж състезанието
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>