@page
@model SportRace.Web.Pages.Account.RegisterModel
@{ViewData["Title"]="Регистрация";}
<div class="row justify-content-center py-5"><div class="col-md-6"><div class="card shadow-sm"><div class="card-body p-4"><h1 class="h3">Регистрация</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col mb-3"><label class="form-label">Име</label><input asp-for="Input.FirstName" class="form-control" required/></div><div class="col mb-3"><label class="form-label">Фамилия</label><input asp-for="Input.LastName" class="form-control" required/></div></div><div class="mb-3"><label class="form-label">E-mail</label><input asp-for="Input.Email" type="email" class="form-control" required/></div><div class="mb-3"><label class="form-label">Парола</label><input asp-for="Input.Password" type="password" class="form-control" required/></div><button class="btn btn-primary">Създай профил</button> <a asp-page="Login" class="btn btn-secondary">Назад</a></form></div></div></div></div>
